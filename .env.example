# Copy this file to backend/.env.local (`cp .env.example backend/.env.local`),
# fill in the five values below, then (re)start the backend: npm run dev.
# backend/.env.local is the only file anywhere that carries credentials.

# Supabase → Project Settings → Data API (curl) → URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → Data API → Publishable key (safe for browsers)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Supabase → Project Settings → Data API → Secret key (server-only; NEVER add a
# NEXT_PUBLIC_ prefix to this one, and never send it to the browser)
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-YOUR_GEMINI_KEY
# Server-only CORS allowlist (comma or space separated) — origins the static
# frontend is actually served from. Unset, the backend already accepts loopback
# 5500/5501/4321; set this only for another port, host or LAN IP.
FRONTEND_ORIGINS=http://localhost:5500, http://127.0.0.1:5500
